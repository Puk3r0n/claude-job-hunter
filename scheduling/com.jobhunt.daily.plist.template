<?xml version="1.0" encoding="UTF-8"?>
<!-- macOS: copy to ~/Library/LaunchAgents/com.jobhunt.daily.plist, replace __REPO__ with the repo path,
     then: launchctl load ~/Library/LaunchAgents/com.jobhunt.daily.plist -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.jobhunt.daily</string>
  <key>ProgramArguments</key><array><string>__REPO__/daily.sh</string></array>
  <key>StartCalendarInterval</key>
  <dict><key>Hour</key><integer>9</integer><key>Minute</key><integer>0</integer></dict>
  <key>StandardOutPath</key><string>__REPO__/logs/launchd.log</string>
  <key>StandardErrorPath</key><string>__REPO__/logs/launchd.log</string>
</dict>
</plist>
